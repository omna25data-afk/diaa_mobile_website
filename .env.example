# Runtime
NODE_ENV=production
PORT=3000

# Hostinger MySQL database
# Example: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=

# Secure administrator session and dashboard login
# Use a random 32+ character value for JWT_SECRET and a unique strong password.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=مدير ضياء موبايل

# S3-compatible media storage (Amazon S3, Cloudflare R2, Backblaze B2, etc.)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket/custom media domain, without a trailing slash.
MEDIA_PUBLIC_BASE_URL=
